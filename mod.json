{
    "geode": "5.8.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "stray_2024.global-mp3-player",
    "name": "Global MP3 Player",
    "version": "1.3.0",
    "developer": "Stray_2024",
    "description": "Replaces the music on every level with a single custom MP3 file.",
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    },
    "settings": {
        "enable-replacement": {
            "name": "Enable music replacement",
            "type": "bool",
            "default": true
        },
        "music-path": {
            "name": "Path to MP3 file",
            "type": "file",
            "control": {
                "filters": [
                    { "description": "Audio files", "extensions": ["mp3"] }
                ]
            },
            "default": ""
        },
        "music-volume": {
            "name": "Custom music volume",
            "type": "float",
            "default": 1.0,
            "control": {
                "min": 0.0,
                "max": 1.0,
                "slider": true
            }
        },
        "fade-duration": {
            "name": "Fade in/out duration (seconds)",
            "type": "float",
            "default": 1.0,
            "control": {
                "min": 0.0,
                "max": 5.0,
                "slider": true
            }
        },
        "screen-pulse": {
            "name": "Screen pulse on bass",
            "type": "bool",
            "default": false
        },
        "side-waves": {
            "name": "Side bass wave bars",
            "type": "bool",
            "default": false
        }
    }
}